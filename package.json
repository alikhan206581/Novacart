{
  "name": "novacart-ecommerce",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n backend,frontend \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "start": "next start frontend",
    "lint": "eslint .",
    "db:push": "dotenv -e backend/.env -- prisma db push --schema backend/prisma/schema.prisma",
    "db:seed": "dotenv -e backend/.env -- node backend/prisma/seed.js",
    "db:studio": "dotenv -e backend/.env -- prisma studio --schema backend/prisma/schema.prisma",
    "postinstall": "dotenv -e backend/.env -- prisma generate --schema backend/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "framer-motion": "^12.23.24",
    "jose": "^6.1.3",
    "lucide-react": "^0.468.0",
    "next": "^15.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.12",
    "dotenv": "^16.6.1",
    "stripe": "^18.5.0"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "eslint-config-next": "^15.5.6",
    "prisma": "^6.19.0",
    "@eslint/eslintrc": "^3.3.1",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^10.0.0"
  }
}