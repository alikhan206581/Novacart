{
  "name": "novacart-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3001",
    "build": "npm run prisma:generate && next build",
    "start": "next start -H 0.0.0.0",
    "prisma:generate": "node scripts/prisma-command.cjs generate",
    "db:push": "node scripts/prisma-command.cjs db push",
    "db:studio": "node scripts/prisma-command.cjs studio",
    "db:seed": "node prisma/seed.js",
    "postinstall": "npm run prisma:generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.6.1",
    "next": "^15.5.6",
    "prisma": "^6.19.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "stripe": "^18.5.0",
    "zod": "^4.1.12"
  }
}
